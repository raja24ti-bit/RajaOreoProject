<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <!-- WELCOME -->
    <TextView
        android:id="@+id/inputNoTujuan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SELAMAT DATANG DI"
        android:textColor="#77717F"
        android:textSize="13sp"
        android:fontFamily="@font/fugazoneregular"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="45dp"/>

    <!-- LOGO -->
    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:src="@drawable/gadoca"
        android:background="@drawable/bg_logo"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/inputNoTujuan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp"/>

    <!-- BRAND NAME -->
    <TextView
        android:id="@+id/tvBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GADOCA"
        android:textSize="30sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textColor="#684B9D"
        app:layout_constraintTop_toBottomOf="@id/imageView2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delicious Food, Happy Moments"
        android:textColor="#88818F"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvBrand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="5dp"/>

    <!-- NAME INPUT -->
    <EditText
        android:id="@+id/idNama"
        android:layout_width="280dp"
        android:layout_height="55dp"
        android:hint="Masukkan Nama"
        android:paddingHorizontal="15dp"
        android:backgroundTint="#684B9D"
        android:textColor="#292333"
        android:textSize="14sp"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"/>

    <!-- PASSWORD INPUT -->
    <EditText
        android:id="@+id/Password"
        android:layout_width="280dp"
        android:layout_height="55dp"
        android:hint="Masukkan Password"
        android:paddingHorizontal="15dp"
        android:backgroundTint="#684B9D"
        android:textColor="#292333"
        android:textSize="14sp"
        android:inputType="textPassword"
        app:layout_constraintTop_toBottomOf="@id/idNama"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <!-- LOGIN BUTTON -->
    <Button
        android:id="@+id/btnMasuk"
        android:layout_width="280dp"
        android:layout_height="52dp"
        android:text="Login To Project"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#684B9D"
        app:cornerRadius="25dp"
        app:layout_constraintTop_toBottomOf="@id/Password"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
