<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selamat Datang"
                    android:textColor="#77717F"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cafe Gadoca"
                    android:textColor="#65469B"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/logoo"
                android:scaleType="fitCenter"/>

        </LinearLayout>

        <!-- SEARCH -->
        <EditText
            android:id="@+id/etSearchMenu"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:background="#FFFFFF"
            android:hint="🔍  Cari makanan favoritmu..."
            android:paddingHorizontal="15dp"
            android:textSize="13sp"
            android:singleLine="true"/>

        <!-- BANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="175dp"
            android:layout_marginTop="22dp"
            android:background="#684B9D"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="15dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPECIAL MENU"
                    android:textColor="#E6D9FF"
                    android:textSize="11sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Nikmati Kelezatan Cafe Gadoca!"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Pesan sekarang dan nikmati menu favoritmu."
                    android:textColor="#F1EAFE"
                    android:textSize="11sp"/>

            </LinearLayout>

            <ImageView
                android:layout_width="105dp"
                android:layout_height="125dp"
                android:src="@drawable/menugadoca1"
                android:scaleType="centerCrop"/>

        </LinearLayout>

        <!-- CATEGORY -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Kategori Menu"
            android:textColor="#292333"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="42dp"
                    android:background="#684B9D"
                    android:gravity="center"
                    android:text="Semua"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:background="#E9E1F5"
                    android:gravity="center"
                    android:text="Makanan"
                    android:textColor="#684B9D"/>

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:background="#E9E1F5"
                    android:gravity="center"
                    android:text="Minuman"
                    android:textColor="#684B9D"/>

                <TextView
                    android:layout_width="110dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:background="#E9E1F5"
                    android:gravity="center"
                    android:text="Cemilan"
                    android:textColor="#684B9D"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- POPULAR MENU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Menu Terpopuler"
                android:textColor="#292333"
                android:textSize="19sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lihat Semua"
                android:textColor="#684B9D"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- FOOD 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginTop="15dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:src="@drawable/menugadoca1"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ayam Geprek"
                    android:textColor="#292333"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Pedasnya mantap!"
                    android:textColor="#88818F"
                    android:textSize="12sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="⭐ 4.9  |  Best Seller"
                    android:textColor="#684B9D"
                    android:textSize="11sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- FOOD 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:src="@drawable/menugadoca2"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ayam Rica Rica"
                    android:textColor="#292333"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Favorit banget!"
                    android:textColor="#88818F"
                    android:textSize="12sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="⭐ 4.8  |  Favorite"
                    android:textColor="#684B9D"
                    android:textSize="11sp"/>

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"/>

    </LinearLayout>

</ScrollView>
